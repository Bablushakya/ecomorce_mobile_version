<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Gulf Free Cravings — Artisanal Indian Mithai</title>
  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            serif: ['"DM Serif Display"', 'Georgia', 'serif'],
            sans: ['"Plus Jakarta Sans"', 'sans-serif'],
          },
          colors: {
            brand: {
              cream: '#FAF6F0',
              creambright: '#FFFDF9',
              dark: '#261610',
              brown: '#3B2317',
              amber: '#C67A18',
              gold: '#D89E34',
              goldsoft: '#F4E7CE',
              border: '#EDE5DA',
              card: '#FFFFFF',
              muted: '#76675B',
              olive: '#4D5837'
            }
          }
        }
      }
    }
  </script>
  <style>
    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
      background-color: #FAF6F0;
      color: #261610;
      -webkit-tap-highlight-color: transparent;
    }
    .font-serif {
      font-family: 'DM Serif Display', Georgia, serif;
    }
    .no-scrollbar::-webkit-scrollbar {
      display: none;
    }
    .no-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
    .drawer-backdrop {
      background: rgba(38, 22, 16, 0.6);
      backdrop-filter: blur(4px);
      -webkit-backdrop-filter: blur(4px);
    }
  </style>
</head>
<body class="bg-brand-cream text-brand-dark min-h-screen pb-24 select-none">

  <!-- 1. TOP ANNOUNCEMENT & STICKY HEADER -->
  <header class="sticky top-0 z-40 bg-brand-cream/95 backdrop-blur-md border-b border-brand-border transition-all duration-200" id="mainHeader">
    <!-- Mini top promo bar -->
    <div class="bg-brand-dark text-brand-goldsoft text-[11px] font-medium tracking-wider text-center py-1.5 px-3 flex items-center justify-center gap-2">
      <span class="inline-block w-1.5 h-1.5 rounded-full bg-brand-gold animate-pulse"></span>
      <span>100% PURE DESI GHEE &bull; ZERO REFINED SUGAR &bull; FRESH BATCHES</span>
    </div>

    <!-- Main Navigation Bar -->
    <div class="px-4 py-3 flex items-center justify-between">
      <!-- Left: Mobile Menu Toggle & Logo -->
      <div class="flex items-center gap-3">
        <button onclick="toggleMobileMenu()" class="w-9 h-9 rounded-full bg-white border border-brand-border flex items-center justify-center text-brand-dark shadow-sm active:scale-95 transition" aria-label="Menu">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"/></svg>
        </button>
        <a href="#" class="flex flex-col">
          <span class="font-serif text-xl font-bold tracking-tight text-brand-dark leading-none">Gulf Free<span class="text-brand-amber font-normal italic"> Cravings</span></span>
          <span class="text-[9px] uppercase tracking-widest text-brand-muted mt-0.5 font-semibold">Artisanal Mithai &bull; Est. 2021</span>
        </a>
      </div>

      <!-- Right: Search & Cart Button -->
      <div class="flex items-center gap-2">
        <button onclick="document.getElementById('sweetsSection').scrollIntoView({behavior: 'smooth'})" class="w-9 h-9 rounded-full bg-white border border-brand-border flex items-center justify-center text-brand-dark shadow-sm active:scale-95 transition" aria-label="Search">
          <svg class="w-4 h-4 text-brand-muted" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z"/></svg>
        </button>
        <!-- Sticky Cart Icon with dynamic counter badge -->
        <button onclick="openCartDrawer()" class="relative h-9 px-3 rounded-full bg-brand-dark text-white flex items-center gap-1.5 shadow-sm active:scale-95 transition">
          <svg class="w-4 h-4 text-brand-gold" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 10-7.5 0v4.5m11.356-1.993l1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 01-1.12-1.243l1.264-12A1.125 1.125 0 015.513 7.5h12.974c.576 0 1.059.435 1.119 1.007zM8.625 10.5a.375.375 0 11-.75 0 .375.375 0 01.75 0zm7.5 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z"/></svg>
          <span class="text-xs font-bold font-sans text-brand-goldsoft" id="navCartCount">2</span>
        </button>
      </div>
    </div>
  </header>

  <!-- MOBILE NAVIGATION DRAWER (SLIDE OVER) -->
  <div id="navDrawer" class="fixed inset-0 z-50 pointer-events-none opacity-0 transition-opacity duration-300">
    <div onclick="toggleMobileMenu()" class="absolute inset-0 drawer-backdrop"></div>
    <div id="navDrawerContent" class="absolute top-0 left-0 bottom-0 w-[280px] bg-brand-cream p-6 shadow-2xl flex flex-col justify-between transform -translate-x-full transition-transform duration-300">
      <div>
        <div class="flex items-center justify-between pb-4 border-b border-brand-border">
          <div>
            <h3 class="font-serif text-lg font-bold text-brand-dark">Gulf Free Cravings</h3>
            <p class="text-[11px] text-brand-muted">Guilt-Free Healthy Indulgence</p>
          </div>
          <button onclick="toggleMobileMenu()" class="w-8 h-8 rounded-full bg-white border border-brand-border flex items-center justify-center text-brand-muted">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
          </button>
        </div>
        <nav class="mt-6 flex flex-col gap-3 font-medium text-sm text-brand-dark">
          <a href="#" onclick="toggleMobileMenu()" class="px-3 py-2 rounded-lg bg-white border border-brand-border text-brand-amber font-semibold flex items-center justify-between">
            <span>Home</span>
            <span class="text-xs text-brand-amber">&bull;</span>
          </a>
          <a href="#sweetsSection" onclick="toggleMobileMenu()" class="px-3 py-2 rounded-lg hover:bg-white text-brand-dark flex items-center justify-between">
            <span>Sweets Collection</span>
            <span class="text-[11px] bg-brand-goldsoft text-brand-brown px-2 py-0.5 rounded-full font-bold">12 Fresh</span>
          </a>
          <a href="#sweetsSection" onclick="filterCategory('Ladoos'); toggleMobileMenu()" class="px-3 py-2 rounded-lg hover:bg-white text-brand-dark">Handcrafted Ladoos</a>
          <a href="#giftingSection" onclick="toggleMobileMenu()" class="px-3 py-2 rounded-lg hover:bg-white text-brand-dark">Festive Gift Boxes</a>
          <a href="#ingredientsSection" onclick="toggleMobileMenu()" class="px-3 py-2 rounded-lg hover:bg-white text-brand-dark">Our Ingredients</a>
          <a href="#whyUsSection" onclick="toggleMobileMenu()" class="px-3 py-2 rounded-lg hover:bg-white text-brand-dark">Why Us & Pure Craft</a>
          <a href="#reviewsSection" onclick="toggleMobileMenu()" class="px-3 py-2 rounded-lg hover:bg-white text-brand-dark">Customer Stories</a>
        </nav>
      </div>
      <div class="pt-6 border-t border-brand-border text-xs text-brand-muted">
        <p class="font-semibold text-brand-dark">Need gifting assistance?</p>
        <p class="mt-1">WhatsApp concierge: +91 98765 43210</p>
        <p class="mt-3 text-[10px] text-stone-400">&copy; 2025 Gulf Free Cravings</p>
      </div>
    </div>
  </div>

  <main>
    <!-- 2. HERO SECTION -->
    <section class="relative px-4 pt-4 pb-6 overflow-hidden">
      <div class="relative rounded-2xl overflow-hidden bg-brand-dark text-white border border-brand-border shadow-md">
        <!-- Hero Background visual -->
        <div class="relative w-full h-[250px] overflow-hidden">
          <img src="https://lh3.googleusercontent.com/aida-public/AB6AXuDRws8_rbcddZpSb45zpN7m9EyoKOe-sX-8T-W6RiKyc-89_2_cGZWipxTgnEQ7CrLBuVT4BXT86ZKv2nCg9j1fXzDvhjp0KorPnwf_a1iQpK2XLv140OPaenj5znkho8CcRZ_1cNaZpU4pDmsp8uMXlGoyScgQ3OhVy5FNLLUxcZZnesyErMCJY2dYLlnI7PsxPCkJdLqh1ExswgOO16lBGxfK4xOZjeez99NCf7poWSD6hX3shl8P_w" alt="Handcrafted Indian Mithai Selection in Brass Thali" class="w-full h-full object-cover object-center transform scale-105" />
          <div class="absolute inset-0 bg-gradient-to-t from-brand-dark via-brand-dark/60 to-transparent"></div>
          <span class="absolute top-3 right-3 bg-brand-gold text-brand-dark text-[10px] font-bold px-2.5 py-1 rounded-full uppercase tracking-wider shadow">
            Festive Batch #42
          </span>
        </div>

        <!-- Hero Content Overlay -->
        <div class="p-5 relative -mt-16 z-10">
          <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-white/10 backdrop-blur-md border border-white/15 text-[11px] text-brand-goldsoft mb-2.5">
            <svg class="w-3.5 h-3.5 text-brand-gold" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            <span>Pure Ingredients &bull; Zero Compromise</span>
          </div>

          <h1 class="font-serif text-3xl font-bold tracking-tight text-white leading-tight">
            Wholesome Goodness,<br>
            <span class="text-brand-gold italic">Irresistible Taste</span>
          </h1>

          <p class="text-stone-300 text-xs mt-2 leading-relaxed max-w-xs">
            Artisanal mithai prepared with wholesome dry fruits, cold-pressed nuts, and organic jaggery. Pure indulgence without regret.
          </p>

          <!-- Direct Hero Action Buttons -->
          <div class="mt-4 flex items-center gap-3">
            <button onclick="document.getElementById('sweetsSection').scrollIntoView({behavior: 'smooth'})" class="flex-1 py-3 px-4 rounded-xl bg-brand-gold text-brand-dark font-bold text-xs flex items-center justify-center gap-2 shadow-lg active:scale-98 transition">
              <span>Shop Sweets</span>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 13.5L12 21m0 0l-7.5-7.5M12 21V3"/></svg>
            </button>
            <a href="#ingredientsSection" class="py-3 px-4 rounded-xl bg-white/10 hover:bg-white/15 border border-white/20 text-white font-semibold text-xs flex items-center justify-center transition">
              Explore Our Story
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. TRUST / USP STRIP -->
    <section class="px-4 py-1">
      <div class="bg-white rounded-xl border border-brand-border p-3 shadow-sm grid grid-cols-2 gap-2.5">
        <div class="flex items-center gap-2.5">
          <div class="w-7 h-7 rounded-lg bg-amber-50 text-brand-amber flex items-center justify-center flex-shrink-0">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"/></svg>
          </div>
          <div>
            <h4 class="text-xs font-bold text-brand-dark leading-tight">No Refined Sugar</h4>
            <p class="text-[10px] text-brand-muted">Only dates & jaggery</p>
          </div>
        </div>

        <div class="flex items-center gap-2.5">
          <div class="w-7 h-7 rounded-lg bg-emerald-50 text-emerald-700 flex items-center justify-center flex-shrink-0">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 01-1.043 3.296 3.745 3.745 0 01-3.296 1.043A3.745 3.745 0 0112 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 01-3.296-1.043 3.745 3.745 0 01-1.043-3.296A3.745 3.745 0 013 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 011.043-3.296 3.746 3.746 0 013.296-1.043A3.746 3.746 0 0112 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 013.296 1.043 3.746 3.746 0 011.043 3.296A3.745 3.745 0 0121 12z"/></svg>
          </div>
          <div>
            <h4 class="text-xs font-bold text-brand-dark leading-tight">No Preservatives</h4>
            <p class="text-[10px] text-brand-muted">Clean & wholesome</p>
          </div>
        </div>

        <div class="flex items-center gap-2.5">
          <div class="w-7 h-7 rounded-lg bg-orange-50 text-orange-700 flex items-center justify-center flex-shrink-0">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z"/></svg>
          </div>
          <div>
            <h4 class="text-xs font-bold text-brand-dark leading-tight">Pure Ingredients</h4>
            <p class="text-[10px] text-brand-muted">A2 ghee & Mamra badam</p>
          </div>
        </div>

        <div class="flex items-center gap-2.5">
          <div class="w-7 h-7 rounded-lg bg-stone-100 text-brand-brown flex items-center justify-center flex-shrink-0">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
          <div>
            <h4 class="text-xs font-bold text-brand-dark leading-tight">Made Fresh Daily</h4>
            <p class="text-[10px] text-brand-muted">Hand-rolled in small batches</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. INTRODUCTION SECTION: "A Healthy Reason to Say Yes" -->
    <section class="px-4 py-6">
      <div class="bg-white rounded-2xl border border-brand-border p-4 shadow-sm">
        <span class="text-[10px] font-bold uppercase tracking-wider text-brand-amber bg-brand-goldsoft/50 px-2.5 py-0.5 rounded-full inline-block mb-2">
          The Clean Mithai Revolution
        </span>
        <h2 class="font-serif text-xl font-bold text-brand-dark leading-snug">
          A Healthy Reason to Say Yes
        </h2>
        <p class="text-xs text-brand-muted mt-1.5 leading-relaxed">
          Traditional Indian sweets crafted for mindful eaters. All the festive indulgence, handcrafted with zero guilt and maximum nourishment.
        </p>

        <!-- Visual + 3 concise benefits -->
        <div class="mt-4 grid grid-cols-1 gap-3">
          <div class="relative rounded-xl overflow-hidden h-36 border border-brand-border">
            <img src="https://lh3.googleusercontent.com/aida-public/AB6AXuBBwEK9WgU2M8R9caHlsZT-mnEmugJMTNDNSN7YP3rxQpMmd2dFAACQdFL9HllVk8cRHqYpo102dkWFajIHNkKq71dFTLNvxPFuPF-XM8j5tG2XzTVPc2WjS3eq0tuuKQJPRBpv9-0sfVVRrupXFcVnEjvaAtb2RWRJlYBOGVZ8H9zAlzcmj3azK8QkS4cLNWNn3YyDMNhTZooRtSLhALT1EXfWQd1QLI0w1ngTT_yswYRzCPfHxiAT_Q" alt="Fresh Sattu and Jaggery healthy mithai bites" class="w-full h-full object-cover object-center" />
            <div class="absolute bottom-2 left-2 bg-brand-dark/85 backdrop-blur-sm text-white px-2.5 py-1 rounded-md text-[10px] font-medium">
              100% Sattu, Roasted Nuts & Organic Jaggery
            </div>
          </div>

          <div class="space-y-2 mt-1">
            <div class="flex items-start gap-2.5 text-xs text-brand-dark">
              <span class="w-5 h-5 rounded-full bg-brand-goldsoft text-brand-brown font-bold text-[10px] flex items-center justify-center flex-shrink-0 mt-0.5">1</span>
              <div>
                <span class="font-bold">Zero Glucose Spikes:</span>
                <span class="text-brand-muted"> Sweetened naturally using black dates and slow-cooked organic jaggery.</span>
              </div>
            </div>

            <div class="flex items-start gap-2.5 text-xs text-brand-dark">
              <span class="w-5 h-5 rounded-full bg-brand-goldsoft text-brand-brown font-bold text-[10px] flex items-center justify-center flex-shrink-0 mt-0.5">2</span>
              <div>
                <span class="font-bold">High Protein & Satiety:</span>
                <span class="text-brand-muted"> Loaded with nutrient-dense Sattu, roasted pistachios, and cashews.</span>
              </div>
            </div>

            <div class="flex items-start gap-2.5 text-xs text-brand-dark">
              <span class="w-5 h-5 rounded-full bg-brand-goldsoft text-brand-brown font-bold text-[10px] flex items-center justify-center flex-shrink-0 mt-0.5">3</span>
              <div>
                <span class="font-bold">Digestive & Heart Healthy:</span>
                <span class="text-brand-muted"> Cardamom, cold-pressed sesame, and pure A2 bilona desi ghee.</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 5. CATEGORY NAVIGATION & 6. BESTSELLERS SHOPPING SECTION -->
    <section id="sweetsSection" class="px-4 pt-2 pb-6">
      <div class="flex items-end justify-between mb-2">
        <div>
          <span class="text-[10px] font-bold uppercase tracking-wider text-brand-amber">Browse & Shop</span>
          <h2 class="font-serif text-2xl font-bold text-brand-dark">Pick Your Favourite</h2>
          <p class="text-xs text-brand-muted mt-0.5">Traditional recipes. Better ingredients. Seriously good taste.</p>
        </div>
      </div>

      <!-- Horizontal category pill filter (Zomato-style quick filtering) -->
      <div class="flex items-center gap-2 overflow-x-auto no-scrollbar py-2.5 -mx-4 px-4 sticky top-16 z-30 bg-brand-cream/95 backdrop-blur-md">
        <button onclick="filterCategory('All')" data-category="All" class="cat-pill px-4 py-2 rounded-full text-xs font-bold transition whitespace-nowrap bg-brand-dark text-brand-goldsoft shadow-sm">
          All Sweets (8)
        </button>
        <button onclick="filterCategory('Ladoos')" data-category="Ladoos" class="cat-pill px-4 py-2 rounded-full text-xs font-semibold transition whitespace-nowrap bg-white text-brand-dark border border-brand-border">
          Ladoos
        </button>
        <button onclick="filterCategory('Dry Fruit')" data-category="Dry Fruit" class="cat-pill px-4 py-2 rounded-full text-xs font-semibold transition whitespace-nowrap bg-white text-brand-dark border border-brand-border">
          Dry Fruit & Nuts
        </button>
        <button onclick="filterCategory('Sattu')" data-category="Sattu" class="cat-pill px-4 py-2 rounded-full text-xs font-semibold transition whitespace-nowrap bg-white text-brand-dark border border-brand-border">
          Healthy Sattu
        </button>
        <button onclick="filterCategory('Dates')" data-category="Dates" class="cat-pill px-4 py-2 rounded-full text-xs font-semibold transition whitespace-nowrap bg-white text-brand-dark border border-brand-border">
          Dates & Figs
        </button>
        <button onclick="filterCategory('Gift Boxes')" data-category="Gift Boxes" class="cat-pill px-4 py-2 rounded-full text-xs font-semibold transition whitespace-nowrap bg-white text-brand-dark border border-brand-border">
          Gift Boxes
        </button>
      </div>

      <!-- 7. 2-COLUMN RESPONSIVE PRODUCT GRID -->
      <div class="grid grid-cols-2 gap-3 mt-3" id="productGrid">

        <!-- Product 1 -->
        <div class="product-item bg-white rounded-xl border border-brand-border p-2.5 flex flex-col justify-between shadow-sm hover:shadow-md transition relative group" data-category="Ladoos Dry Fruit" data-id="p1">
          <div>
            <div class="relative rounded-lg overflow-hidden bg-stone-50 aspect-square cursor-pointer" onclick="openQuickView('Royal Dry Fruit Ladoo', '4.9 (128)', '₹480', 'Box of 12 pcs &bull; 400g', 'https://lh3.googleusercontent.com/aida-public/AB6AXuBhV4sxwYhe2gAYghT2ytsnuaCdcqClD1QgwKELJSNK5ldAUk82PmaK1pw1_9szRTFHdZNCCqLuKPJuQYAZRGXlgTxAn28HSJq81EcSOFdNyUHfPKAjqn0hLL3zIz7-vmM3zD0Inhy0HK3Kjej1eHLJZG6_stEbEWe17z0lX4pVZK3Z3PlDCpjJ_iT6qRLov7n3h8J93zindN89-WUXVLmoxS092jMaNlaRhfiA2GbQjyB3bfHONl5uxg', 'Handcrafted with crunchy roasted Mamra almonds, Iranian pistachios, and Cashews bound purely with Arabian dates and pure A2 Desi Ghee. Zero white sugar.', 'Almonds, Pistachios, Cashews, Dates, Cardamom, A2 Ghee', 'p1')">
              <img src="https://lh3.googleusercontent.com/aida-public/AB6AXuBhV4sxwYhe2gAYghT2ytsnuaCdcqClD1QgwKELJSNK5ldAUk82PmaK1pw1_9szRTFHdZNCCqLuKPJuQYAZRGXlgTxAn28HSJq81EcSOFdNyUHfPKAjqn0hLL3zIz7-vmM3zD0Inhy0HK3Kjej1eHLJZG6_stEbEWe17z0lX4pVZK3Z3PlDCpjJ_iT6qRLov7n3h8J93zindN89-WUXVLmoxS092jMaNlaRhfiA2GbQjyB3bfHONl5uxg" alt="Royal Dry Fruit Ladoo" class="w-full h-full object-cover group-hover:scale-105 transition duration-300" />
